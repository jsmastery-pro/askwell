# Postgres connection string (InstaCloud Postgres)
DATABASE_URL=

# S3-compatible object storage endpoint, for uploaded knowledge files (InstaCloud storage)
STORAGE_ENDPOINT=

# S3-compatible region for uploaded knowledge files
STORAGE_REGION=

# S3-compatible bucket name for uploaded knowledge files
STORAGE_BUCKET=

# S3-compatible access key for uploaded knowledge files
STORAGE_ACCESS_KEY=

# S3-compatible secret key for uploaded knowledge files
STORAGE_SECRET_KEY=

# Clerk publishable key, read by the browser for sign-in/sign-up UI
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key, for server-side session verification
CLERK_SECRET_KEY=

# OpenAI API key, for chat and embedding models
OPENAI_API_KEY=

# Stripe secret key, for Checkout and the customer portal (test mode)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret, to verify incoming webhook requests
STRIPE_WEBHOOK_SECRET=

# Stripe Price ID for the Pro plan (test mode)
STRIPE_PRICE_PRO=

# PostHog project key, for product analytics and session replay
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host URL
NEXT_PUBLIC_POSTHOG_HOST=

# Public base URL of this app, used by the client and the server
NEXT_PUBLIC_APP_URL=
