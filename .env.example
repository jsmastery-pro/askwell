# Postgres connection string (InstaCloud Postgres)
DATABASE_URL=

# Knowledge file storage: Supabase Storage's S3-compatible API (standard AWS SDK env names).
# Values come from the Supabase project's Storage → Settings → S3 access keys.
# S3-compatible endpoint. Required: without it the AWS SDK talks to real AWS
AWS_ENDPOINT_URL_S3=

# Storage region, from Supabase's S3 connection details
AWS_REGION=

# The private "knowledge" bucket for uploaded knowledge files
BUCKET_NAME=

# Storage access key
AWS_ACCESS_KEY_ID=

# Storage secret key, server-only
AWS_SECRET_ACCESS_KEY=

# Clerk publishable key, read by the browser for sign-in/sign-up UI
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key, for server-side session verification
CLERK_SECRET_KEY=

# Clerk webhook signing secret, to verify incoming /api/clerk/webhook requests (Clerk Billing)
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI API key, for chat and embedding models
OPENAI_API_KEY=

# Arcjet site key, server-only: per-minute rate limits on the public widget routes
ARCJET_KEY=

# PostHog project key, for product analytics and session replay
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host URL
NEXT_PUBLIC_POSTHOG_HOST=

# Public base URL of this app, used by the client and the server
NEXT_PUBLIC_APP_URL=

# Public key (pk_...) of the Askwell project the landing page's own chat widget runs on. Optional: unset, the landing page shows no widget
LANDING_WIDGET_KEY=
