{
  "name": "askwell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "db:types": "pnpm --silent dlx supabase@2.122.0 gen types --lang typescript --project-id pjyukeqhjqgqazdwwjuv --schema public > packages/db/types.ts.tmp && mv packages/db/types.ts.tmp packages/db/types.ts || (rm -f packages/db/types.ts.tmp && exit 1)"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
