{
  "name": "askwell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @askwell/db db:generate",
    "db:migrate": "pnpm --filter @askwell/db db:migrate",
    "supabase": "pnpm --filter @askwell/db exec supabase --workdir ../.."
  },
  "devDependencies": {
    "turbo": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
