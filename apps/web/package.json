{
  "name": "@askwell/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm copy-widget && next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern public/widget.js",
    "test": "vitest run",
    "build": "pnpm copy-widget && next build",
    "copy-widget": "node -e \"const fs=require('node:fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('../widget/dist/widget.js','public/widget.js')\"",
    "seed-knowledge": "tsx --conditions=react-server scripts/seed-knowledge.ts"
  },
  "dependencies": {
    "@askwell/db": "workspace:*",
    "@askwell/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@clerk/nextjs": "^7.9.11",
    "drizzle-orm": "catalog:",
    "next": "16.3.4",
    "openai": "^7.30.1",
    "posthog-js": "^1.438.12",
    "posthog-node": "^5.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.0"
  },
  "devDependencies": {
    "@askwell/widget": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-pgvector": "catalog:",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "catalog:",
    "jsdom": "30.0.1",
    "postcss": "8.5.27",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vitest": "catalog:"
  }
}
